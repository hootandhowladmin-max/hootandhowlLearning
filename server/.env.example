MAIL_PROVIDER=mailjet
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_FROM="Hoot & Howl Learning <noreply@yourdomain.com>"
GOOGLE_FORMS_SYNC_SECRET=replace-with-a-long-random-secret

# Replace yourdomain.com with the domain you verify in Mailjet/your SMTP provider.
# Free email addresses like Gmail are more likely to be flagged as spam.

# WhatsApp Business API
WHATSAPP_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TEMPLATE_NAME=absence_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

SMTP_FROM="Hoot & Howl Learning <noreply@yourdomain.com>"
SMTP_DEBUG_TO=

# Optional fallback SMTP config
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-gmail-address
# SMTP_PASS=your-gmail-app-password